    {
      "cell_type": "code",
      "source": [
        "#Carga de Datos y visualización de variables\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "precio_casas = pd.read_csv(\"precio_casas.csv\", sep=\";\")\n",
        "\n",
        "print(precio_casas.shape)\n",
        "print(precio_casas.head())\n",
        "print(precio_casas.describe().round(2))\n",
        "print(f\"\\nCantidad de valores nulos\\n{precio_casas.isnull().sum()}\")\n",
        "\n",
        "precio_casas.hist(bins=30, figsize=(14, 10), color=\"skyblue\", edgecolor=\"black\")\n",
        "plt.suptitle(\"Distribución de variables\", fontsize=14)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "metadata": {
